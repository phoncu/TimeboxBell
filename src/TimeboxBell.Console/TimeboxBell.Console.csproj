<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Namespace nesmí být TimeboxBell.Console, jinak by zastínil System.Console. -->
    <RootNamespace>TimeboxBell.ConsoleApp</RootNamespace>
    <AssemblyName>TimeboxBell.Console</AssemblyName>
    <!-- Ikona .exe (zástupce na ploše, Průzkumník); generuje ji build/make-icon.ps1. -->
    <ApplicationIcon>..\TimeboxBell.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publikace: jeden .exe včetně runtime, aby šel spustit na PC bez nainstalovaného .NET. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeboxBell.Windows\TimeboxBell.Windows.csproj" />
  </ItemGroup>

</Project>
