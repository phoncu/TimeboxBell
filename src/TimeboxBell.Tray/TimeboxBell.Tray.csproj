<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TimeboxBell.Tray</RootNamespace>
    <AssemblyName>TimeboxBell</AssemblyName>
    <!-- Ikona .exe (zástupce na ploše, Průzkumník); generuje ji build/make-icon.ps1. -->
    <ApplicationIcon>..\TimeboxBell.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Publikace: jeden .exe včetně runtime, aby šel spustit na PC bez nainstalovaného .NET. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TimeboxBell.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeboxBell.Windows\TimeboxBell.Windows.csproj" />
  </ItemGroup>

</Project>
