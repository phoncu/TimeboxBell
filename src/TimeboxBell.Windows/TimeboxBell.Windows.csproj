<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>TimeboxBell.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TimeboxBell.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Media.SoundPlayer (ověření hlavičky WAV + asynchronní PlaySound). -->
    <PackageReference Include="System.Windows.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Výchozí nastavení vedle každého .exe; při single-file publikaci zůstane samostatným souborem. -->
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeboxBell.Core\TimeboxBell.Core.csproj" />
  </ItemGroup>

</Project>
