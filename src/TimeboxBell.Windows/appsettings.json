{
  // Nastavení TimeboxBell. Změna se projeví po restartu programu.
  // Chybějící soubor nebo klíč = výchozí hodnota.

  // Minuty v hodině (0–59, místní čas) a druh zvonění: Warning, PomodoroEnd, NewHalfHour.
  // Uvedený seznam nahradí celý výchozí rozvrh.
  "Bells": [
    { "Minute": 0, "Type": "NewHalfHour" },
    { "Minute": 23, "Type": "Warning" },
    { "Minute": 25, "Type": "PomodoroEnd" },
    { "Minute": 30, "Type": "NewHalfHour" },
    { "Minute": 53, "Type": "Warning" },
    { "Minute": 55, "Type": "PomodoroEnd" }
  ],

  // Zvuk (.wav) pro každý druh zvonění. Relativní cesta se bere vůči složce s tímto souborem,
  // "" znamená jen pípnutí. Chybějící nebo nepřehratelný soubor také vyvolá pípnutí.
  "Sounds": {
    "Warning": "C:\\Windows\\Media\\Windows Notify Calendar.wav",
    "PomodoroEnd": "C:\\Windows\\Media\\Alarm01.wav",
    "NewHalfHour": "C:\\Windows\\Media\\Alarm05.wav"
  },

  // Bránit uspání počítače a zhasnutí obrazovky, dokud program běží.
  "PreventSleep": true
}
